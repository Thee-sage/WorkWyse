# ─────────────────────────────────────────────────────────────────────
# WorkWyse API configuration
#
# Copy to .env for local development. In production these are set as
# Azure App Service application settings, never as a file in the image.
# config/env.ts validates every value at startup and refuses to boot on a
# configuration that would be silently broken or insecure.
# ─────────────────────────────────────────────────────────────────────

# MongoDB Configuration
MONGODB_URI=mongodb://your-username:your-password@your-cluster.mongodb.net:27017/?ssl=true&replicaSet=your-replica-set&authSource=admin&retryWrites=true

# Server Configuration
NODE_ENV=development
# Azure App Service injects PORT; do not hardcode it there.
PORT=5000

# JWT — must be at least 32 characters, and the two MUST differ.
# Startup fails if they match: a shared secret lets a refresh token be
# replayed as an access token if any type check is ever missed.
JWT_SECRET=your-jwt-secret-here-at-least-32-characters
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Gmail SMTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# CORS — comma-separated exact origins. Must be https:// in production.
# A "*" inside an entry matches one label, so preview deployments can be
# admitted without allowing everything:
#   https://workwyse.vercel.app,https://*-yourteam.vercel.app
CORS_ORIGIN=http://localhost:3000

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Observability ───────────────────────────────────────────────────
# TraceOps ships request telemetry to an external endpoint. Leave blank
# unless that destination is covered by the same confidentiality
# guarantees as the database.
TRACEOPS_ENDPOINT=
TRACEOPS_API_KEY=

# ─── Deployment topology ─────────────────────────────────────────────
# Number of reverse proxies in front of the app. 1 is correct for a stock
# Azure App Service. Set to 2 if you add Front Door or a CDN. At 0, every
# visitor is bucketed under the proxy address and rate limiting collapses.
TRUST_PROXY_HOPS=1

# Refresh-cookie behaviour. The Vercel frontend and the Azure API are
# different registrable domains, so the exchange is cross-site and
# production needs SameSite=None with Secure. Leave unset to get the
# correct default per environment (none in production, lax otherwise).
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# Set only when the API and frontend share a parent domain.
# COOKIE_DOMAIN=

# ─── Rate limiting ───────────────────────────────────────────────────
# Coarse abuse ceiling, keyed by client address. Visitors behind a shared
# egress address share this bucket, so keep it well above single-user
# traffic. Per-feature budgets (uploads, votes, submissions) are separate
# and keyed per user.
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_WINDOW_MS=900000
# Disable only against a throwaway environment during load testing.
RATE_LIMIT_ENABLED=true

# ─── Outbound fetch hardening ────────────────────────────────────────
# Lets the job-URL extractor reach private and loopback addresses. This is
# SSRF protection; startup fails if it is enabled in production. Turn it on
# only to point the extractor at a fixture server during local development.
ALLOW_PRIVATE_NETWORK_FETCH=false

# ─── Admin access passphrase ──────────────────────────────────────────
# Second factor required to unlock admin actions, beyond having an admin
# role account. Required in production (min 16 chars) — startup fails
# without it. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_ACCESS_PASSPHRASE=

# ─── Logging ─────────────────────────────────────────────────────────
# App Service containers have an ephemeral, sometimes read-only app
# directory, so file transports are opt-in. stdout is what App Service
# collects.
LOG_TO_FILE=false
