# MongoDB Configuration
MONGODB_URI=mongodb://your-username:your-password@your-cluster.mongodb.net:27017/?ssl=true&replicaSet=your-replica-set&authSource=admin&retryWrites=true

# Server Configuration
NODE_ENV=development
PORT=5000

# JWT — must be at least 32 characters
JWT_SECRET=your-jwt-secret-here-at-least-32-characters
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Gmail SMTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# CORS
CORS_ORIGIN=http://localhost:3000

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# TraceOps
TRACEOPS_ENDPOINT=https://trace-ops.onrender.com
TRACEOPS_API_KEY=your-traceops-api-key
