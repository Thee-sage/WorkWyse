# traceops-sdk declares a peer dependency on express@^4 while this project
# runs express@5. That's the only conflict here — everything else resolves
# cleanly — but without this flag, any `npm install`/`npm ci` (including
# Azure's Oryx build-on-deploy) fails outright rather than just warning.
# See package.json's "verify" script comment history / prior deploy notes
# for context if this ever needs revisiting.
legacy-peer-deps=true
